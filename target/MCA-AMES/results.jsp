<%@ page import="java.sql.*,in.gitam.ames.DB" %><%@ page contentType="text/html;charset=UTF-8" %><% if(session.getAttribute("userId")==null){response.sendRedirect("index.jsp");return;} %><!doctype html><html><head><title>Results | MCA AMES</title><link rel="stylesheet" href="assets/style.css"></head><body><div class="nav"><b>MCA AMES / Results</b><a href="dashboard.jsp">Dashboard</a></div><div class="wrap"><div class="panel"><h2>Calculated Result</h2><p class="muted">Internal is normalized to 40 marks from SESSIONAL + ASSIGNMENT + CLASSWORK. External is normalized to 60 marks. Configure source maximums consistently for your department's assessment policy.</p><table><tr><th>Roll</th><th>Student</th><th>Internal / 40</th><th>External / 60</th><th>Total / 100</th><th>Grade</th></tr><% try(Connection c=DB.get();Statement st=c.createStatement();ResultSet r=st.executeQuery("SELECT s.roll_no,s.full_name,COALESCE(SUM(CASE WHEN a.assessment_type IN ('SESSIONAL','ASSIGNMENT','CLASSWORK') THEN a.marks_obtained ELSE 0 END),0) i,COALESCE(SUM(CASE WHEN a.assessment_type='EXTERNAL' THEN a.marks_obtained ELSE 0 END),0) e,COALESCE(SUM(CASE WHEN a.assessment_type IN ('SESSIONAL','ASSIGNMENT','CLASSWORK') THEN a.max_marks ELSE 0 END),0) im,COALESCE(SUM(CASE WHEN a.assessment_type='EXTERNAL' THEN a.max_marks ELSE 0 END),0) em FROM students s LEFT JOIN assessments a ON a.student_id=s.id GROUP BY s.id")){while(r.next()){double im=r.getDouble("im"),em=r.getDouble("em"),iv=im==0?0:r.getDouble("i")/im*40,ev=em==0?0:r.getDouble("e")/em*60,total=iv+ev;String grade=total>=90?"A+":total>=80?"A":total>=70?"B+":total>=60?"B":total>=50?"C":total>=40?"D":"F"; %><tr><td><%=r.getString("roll_no")%></td><td><%=r.getString("full_name")%></td><td><%=String.format("%.2f",iv)%></td><td><%=String.format("%.2f",ev)%></td><td><b><%=String.format("%.2f",total)%></b></td><td><%=grade%></td></tr><%}}catch(Exception e){out.print(e.getMessage());}%></table></div></div></body></html>