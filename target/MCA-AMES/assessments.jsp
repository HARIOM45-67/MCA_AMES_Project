<%@ page import="java.sql.*,in.gitam.ames.DB" %><%@ page contentType="text/html;charset=UTF-8" %><% if(session.getAttribute("userId")==null){response.sendRedirect("index.jsp");return;} String role=(String)session.getAttribute("role"); if("STUDENT".equals(role)){response.sendError(403);return;} %><!doctype html><html><head><title>Assessments | MCA AMES</title><link rel="stylesheet" href="assets/style.css"></head><body><div class="nav"><b>MCA AMES / Assessments</b><a href="dashboard.jsp">Dashboard</a></div><div class="wrap"><div class="panel"><h2>Enter Assessment Marks</h2><% if(request.getParameter("saved")!=null){ %><p class="success">Assessment marks saved successfully.</p><% } if(request.getParameter("error")!=null){ %><p class="error">Could not save marks. Obtained marks must not exceed maximum marks.</p><% } %><form method="post" action="assessment"><label>Student</label><select name="studentId"><% try(Connection c=DB.get();Statement st=c.createStatement();ResultSet r=st.executeQuery("SELECT id,roll_no,full_name FROM students ORDER BY roll_no")){while(r.next()){ %><option value="<%=r.getInt("id")%>"><%=r.getString("roll_no")%> - <%=r.getString("full_name")%></option><%}}catch(Exception e){} %></select><label>Assessment type</label><select name="type"><option>SESSIONAL</option><option>ASSIGNMENT</option><option>CLASSWORK</option><option>EXTERNAL</option></select><label>Title</label><input name="title" required><label>Marks obtained</label><input name="marks" type="number" min="0" step="0.01" required><label>Maximum marks</label><input name="max" type="number" min="0.01" step="0.01" required><label>Date</label><input name="date" type="date" required><button>Save Marks</button></form></div><div class="panel"><h2>Assessment Records</h2><table><tr><th>Student ID</th><th>Type</th><th>Title</th><th>Marks</th><th>Date</th></tr><% try(Connection c=DB.get();Statement st=c.createStatement();ResultSet r=st.executeQuery("SELECT * FROM assessments ORDER BY assessment_date DESC")){while(r.next()){ %><tr><td><%=r.getInt("student_id")%></td><td><%=r.getString("assessment_type")%></td><td><%=r.getString("title")%></td><td><%=r.getBigDecimal("marks_obtained")%>/<%=r.getBigDecimal("max_marks")%></td><td><%=r.getDate("assessment_date")%></td></tr><%}}catch(Exception e){out.print(e.getMessage());}%></table></div></div></body></html>