<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html><head><title>MCA AMES Login</title><link rel="stylesheet" href="assets/style.css"></head><body><div class="wrap" style="max-width:480px;margin-top:8vh"><div class="hero"><h1>MCA AMES</h1><p>MCA Assessment Management Examination System</p><small>GITAM | MCA Department</small></div><div class="panel"><h2>Sign in</h2><% if(request.getParameter("error")!=null){ %><p class="error">Invalid email or password.</p><% } %><form method="post" action="login"><label>Email</label><input name="email" type="email" required placeholder="name@gitam.edu"><label>Password</label><input name="password" type="password" required><button type="submit">Login</button></form><p class="muted">Demo: admin@gitam.edu / password123</p></div></div></body></html>