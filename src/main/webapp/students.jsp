<%@ page import="java.sql.*,in.gitam.ames.DB" %><%@ page contentType="text/html;charset=UTF-8" %><% if(session.getAttribute("userId")==null){response.sendRedirect("index.jsp");return;} String role=(String)session.getAttribute("role"); if("STUDENT".equals(role)){response.sendError(403);return;} %><!doctype html><html><head><title>Students | MCA AMES</title><link rel="stylesheet" href="assets/style.css"></head><body><div class="nav"><b>MCA AMES / Students</b><a href="dashboard.jsp">Dashboard</a></div><div class="wrap"><div class="panel"><h2>Add Student</h2><% if(request.getParameter("added")!=null){ %><p class="success">Student added successfully.</p><% } if(request.getParameter("error")!=null){ %><p class="error">Could not save student. Check the required fields and roll number.</p><% } %><form method="post" action="students"><label>Roll number</label><input name="roll" required maxlength="40"><label>Full name</label><input name="name" required maxlength="120"><label>Email</label><input name="email" type="email" maxlength="160"><label>Semester</label><input name="semester" type="number" min="1" max="6" value="1" required><label>Phone</label><input name="phone" maxlength="20"><button>Save Student</button></form></div><div class="panel"><h2>Student List</h2><table><tr><th>Roll</th><th>Name</th><th>Email</th><th>Semester</th></tr><% try(Connection c=DB.get();Statement st=c.createStatement();ResultSet r=st.executeQuery("SELECT * FROM students ORDER BY id DESC")){while(r.next()){ %><tr><td><%=r.getString("roll_no")%></td><td><%=r.getString("full_name")%></td><td><%=r.getString("email")%></td><td><%=r.getInt("semester")%></td></tr><%}}catch(Exception e){out.print("Database error: "+e.getMessage());}%></table></div></div></body></html>