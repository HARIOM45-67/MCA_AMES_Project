<%@ page import="java.sql.*,in.gitam.ames.DB" %><%@ page contentType="text/html;charset=UTF-8" %><% if(session.getAttribute("userId")==null){response.sendRedirect("index.jsp");return;} String role=(String)session.getAttribute("role"); if("STUDENT".equals(role)){response.sendError(403);return;} %><!doctype html><html><head><title>Attendance | MCA AMES</title><link rel="stylesheet" href="assets/style.css"></head><body><div class="nav"><b>MCA AMES / Attendance</b><a href="dashboard.jsp">Dashboard</a></div><div class="wrap"><div class="panel"><h2>Mark Attendance</h2><% if(request.getParameter("saved")!=null){ %><p class="success">Attendance saved successfully.</p><% } if(request.getParameter("error")!=null){ %><p class="error">Could not save attendance. Check the student, date and status.</p><% } %><form method="post" action="attendance"><label>Student</label><select name="studentId"><% try(Connection c=DB.get();Statement st=c.createStatement();ResultSet r=st.executeQuery("SELECT id,roll_no,full_name FROM students ORDER BY roll_no")){while(r.next()){ %><option value="<%=r.getInt("id")%>"><%=r.getString("roll_no")%> - <%=r.getString("full_name")%></option><%}}catch(Exception e){} %></select><label>Date</label><input type="date" name="date" required><label>Status</label><select name="status"><option>PRESENT</option><option>ABSENT</option></select><button>Save Attendance</button></form></div><div class="panel"><h2>Attendance Summary</h2><table><tr><th>Roll</th><th>Student</th><th>Present</th><th>Total</th><th>Percentage</th></tr><% try(Connection c=DB.get();Statement st=c.createStatement();ResultSet r=st.executeQuery("SELECT s.roll_no,s.full_name,COUNT(a.id) total,SUM(a.status='PRESENT') present FROM students s LEFT JOIN attendance a ON a.student_id=s.id GROUP BY s.id")){while(r.next()){int t=r.getInt("total"),pr=r.getInt("present"); %><tr><td><%=r.getString("roll_no")%></td><td><%=r.getString("full_name")%></td><td><%=pr%></td><td><%=t%></td><td><%=t==0?0:Math.round(pr*100.0/t)%>%</td></tr><%}}catch(Exception e){out.print(e.getMessage());}%></table></div></div></body></html>